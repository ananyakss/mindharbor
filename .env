# Copy to .env and fill in values (do not commit .env)

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=YourApp

# JWT signing key (use a long random secret in production)
JWT_KEY=ReplaceWithSecureProductionKey

# Optional: used when building the frontend image for Render (public backend URL)
# API_URL=https://your-backend.onrender.com/api
